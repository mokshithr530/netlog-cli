# Maintainer: Mokshith Reddy <mokshithr530@gmail.com>
pkgname=netlog-cli
pkgver=1.1.0
pkgrel=1
pkgdesc="High-performance CLI network telemetry dashboard tracking socket states, live bandwidth rates, and async DNS"
arch=('any')
url="https://github.com/mokshithr530/netlog-cli"
license=('MIT')
depends=('python' 'python-psutil' 'python-rich')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
checkdepends=('python-pytest')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

check() {
    cd "$pkgname-$pkgver"
    pytest
}

package() {
    cd "$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 packaging/netlog.service "$pkgdir/usr/lib/systemd/user/netlog.service"
    install -Dm644 completions/netlog.bash "$pkgdir/usr/share/bash-completion/completions/netlog"
    install -Dm644 completions/netlog.zsh "$pkgdir/usr/share/zsh/site-functions/_netlog"
    install -Dm644 completions/netlog.fish "$pkgdir/usr/share/fish/vendor_completions.d/netlog.fish"
}
